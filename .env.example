# Docker feature backends call the Ollama process running on the host.
# Native host backends should export http://127.0.0.1:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_NUM_CTX=8192
APP_ENV=development

# Shared MCP/RAG remain local host processes; opt in for Release 1.
AI_SERVICES_ENABLED=false
OLLAMA_ENABLED=true
MCP_BASE_URL=http://host.docker.internal:8765
RAG_BASE_URL=http://host.docker.internal:8766
RAG_GENERATION_TIMEOUT_SECONDS=210
# Used when launching shared services on the host, not by feature containers.
AI_SERVICES_HOST=127.0.0.1
STUDENT2_DATABASE_API_URL=http://127.0.0.1:5002
